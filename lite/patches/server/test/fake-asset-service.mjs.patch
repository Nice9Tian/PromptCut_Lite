index 0442dd71d54135d4b2505a73f73e839fd3f68f8a..c4c99f81118bfeecc187adfa380cb3cc1af876ef 100644
--- a/server/test/fake-asset-service.mjs
+++ b/server/test/fake-asset-service.mjs
@@ -160,3 +160,26 @@ export function createAssetHarness() {
 
   return { asset, serve, memoryStore, cleanup, compileTs };
 }
+
+export async function assetTicketKit() {
+  const state = { generation: 1 };
+  let seq = 0;
+  const issued = new Map();
+  return {
+    issue(access = 'r', extra = {}) {
+      const token = `fake-ticket-${++seq}-${state.generation}`;
+      issued.set(token, { access, generation: state.generation, projectId: 'default', userId: 'local', ...extra });
+      return token;
+    },
+    bump(fn) {
+      fn(state);
+    },
+    tickets: {
+      verify(token) {
+        const rec = issued.get(String(token || ''));
+        if (!rec || rec.generation !== state.generation) return { ok: false, reason: 'invalid' };
+        return { ok: true, access: rec.access, projectId: rec.projectId, userId: rec.userId, ...(rec.service ? { service: rec.service } : {}), ...(rec.actsFor ? { actsFor: rec.actsFor } : {}) };
+      },
+    },
+  };
+}
