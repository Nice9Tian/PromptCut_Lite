+/** 回环地址:127.0.0.0/8、::1、IPv4 映射的 ::ffff:127.x */
+export function isLoopbackAddress(address) {
+  const a = String(address || "").toLowerCase();
+  return a === "::1" || /^127\./.test(a) || /^::ffff:127\./.test(a);
+}
+
+function hopAddress(raw) {
+  let s = String(raw ?? "").trim();
+  if (!s) return "";
+  if (s.startsWith('"') && s.endsWith('"') && s.length >= 2) s = s.slice(1, -1).trim();
+  if (!s) return "";
+  if (s.startsWith("[")) {
+    const end = s.indexOf("]");
+    if (end > 0) return s.slice(1, end).toLowerCase();
+  }
+  const colons = (s.match(/:/g) || []).length;
+  if (colons === 1) s = s.slice(0, s.indexOf(":"));
+  return s.toLowerCase();
+}
+
+export function forwardedHops(req) {
+  const out = [];
+  const xff = req?.headers?.["x-forwarded-for"];
+  const xffText = Array.isArray(xff) ? xff.join(",") : String(xff ?? "");
+  if (xffText.trim()) {
+    for (const part of xffText.split(",")) {
+      const h = hopAddress(part);
+      if (h) out.push(h);
+    }
+  }
+  const fwd = req?.headers?.["forwarded"];
+  const fwdText = Array.isArray(fwd) ? fwd.join(",") : String(fwd ?? "");
+  if (fwdText.trim()) {
+    for (const elem of fwdText.split(",")) {
+      for (const pair of elem.split(";")) {
+        const eq = pair.indexOf("=");
+        if (eq < 0) continue;
+        if (pair.slice(0, eq).trim().toLowerCase() !== "for") continue;
+        const h = hopAddress(pair.slice(eq + 1));
+        if (h) out.push(h);
+      }
+    }
+  }
+  const realIp = req?.headers?.["x-real-ip"];
+  const realText = Array.isArray(realIp) ? realIp.join(",") : String(realIp ?? "");
+  if (realText.trim()) {
+    const h = hopAddress(realText);
+    if (h) out.push(h);
+  }
+  return out;
+}
+
+export function isLocalOrigin(req, address = req?.socket?.remoteAddress) {
+  if (!isLoopbackAddress(address)) return false;
+  for (const hop of forwardedHops(req)) {
+    if (!isLoopbackAddress(hop)) return false;
+  }
+  return true;
+}
+
+export function remoteTagOf(req) {
+  const remote = req?.socket?.remoteAddress;
+  if (!remote) return null;
+  if (isLoopbackAddress(remote) && !isLocalOrigin(req, remote)) return `proxied:${remote}`;
+  return String(remote);
+}
 
